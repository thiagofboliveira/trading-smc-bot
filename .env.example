# SMC Trader — Configurações de Ambiente (E0-1, E4-1, E6-1)

# Persistência de Dados (SQLite)
SMC_DB_PATH=data/smc_trader.db

# Notificações e Alertas Telegram (E4)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_AUTHORIZED_CHAT_IDS=123456789,987654321

# Conexão com Corretora MT5 (E6) - Opcional para Execução com Confirmação
MT5_LOGIN=12345678
MT5_PASSWORD=sua_senha_aqui
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=/caminho/para/terminal64.exe

# Chave de Licença Offline (E8-7)
SMC_LICENSE_KEY=
