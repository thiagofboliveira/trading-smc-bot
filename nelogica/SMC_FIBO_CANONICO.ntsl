// ==============================================================================
// SMC-FIBO CANÔNICO (NTSL / PROFIT / RICO TRADER / B3)
// ==============================================================================
// Estratégia Canônica SMC Fibonacci OTE em M5
// Versão: 3.1 — NÃO COMPILADO NEM TESTADO NO PROFIT. Revisão: docs/REVISAO_IMPLEMENTACAO_BACKLOG.md
// Antes de usar em simulado: compilar, conferir BuyLimit/SellShortLimit/SellToCover*/BuyToCover*,
// BuyPrice/SellPrice, MinPriceIncrement e Time na versão do Profit, e fixar o modo de cálculo
// (a lógica abaixo assume execução a cada FECHAMENTO de barra M5).
// Ordens do NTSL valem uma barra: por isso stop, alvo e limite são REENVIADOS a cada barra.
// Compatível com: Mini-Índice (WIN), Mini-Dólar (WDO), Ações (PETR4, VALE3)
// ==============================================================================

Parametro
  FiboEntrada(0.705);           // Nível Sweet Spot Institucional (70.5%)
  FiboStop(0.790);              // Nível de Invalidação Curto (79.0% ou 1.000 Estrutural)
  PeriodoMME(8);                // MME de Condução de Saída
  UsarTrava2para1(Falso);       // Trava 2:1 (Verdadeiro no Modelo Blindado: sobe SL para +1R)
  MaxBarrasPerna(60);           // N-05: Expiração da perna após 60 barras M5
  HorarioLimiteEntrada(1700);   // N-04: Sem novas entradas após 17:00 BRT
  HorarioZeragem(1745);         // N-04: Zeragem obrigatória day trade às 17:45 BRT
  OffsetStopTicks(5);           // Offset de execução do Stop na Bolsa
  AmplitudeMinimaTicks(10);     // Perna menor que isso é ignorada (Python: 10 x spread)
  RiscoMinimoTicks(2);          // Risco menor que isso não arma a entrada (Python: 1.5 x spread)
  ExibirTopoFundo(Verdadeiro);  // Plota linhas de Topo e Fundo institucionais

Var
  mme8              : Real;
  topoFractal       : Booleano;
  fundoFractal      : Booleano;
  ultimoTopo        : Real;
  ultimoFundo       : Real;
  ultimoTopoIdx     : Inteiro;
  ultimoFundoIdx    : Inteiro;
  
  precoEntrada      : Real;
  precoStop         : Real;
  precoAlvo         : Real;
  riscoInicial      : Real;
  travaAtivada      : Booleano;
  
  pernadaAltaAtiva  : Booleano;
  pernadaBaixaAtiva : Booleano;
  barrasPerna       : Inteiro;
  bosBarIdx         : Inteiro;
  refTopo           : Real;
  refFundo          : Real;
  diffPernada       : Real;
  nivelEntrada      : Real;
  nivelStop         : Real;
  barraAtual        : Inteiro;
  barraEntrada      : Inteiro;
  posInicializada   : Booleano;
  stopPerna         : Real;
  alvoPerna         : Real;
  riscoPerna        : Real;
  armar             : Booleano;

Inicio
  // 1. Configuração Visual
  SetPlotColor(1, clAqua);
  SetPlotColor(2, clFuchsia);
  SetPlotWidth(1, 2);
  SetPlotWidth(2, 2);

  mme8 := MediaExp(PeriodoMME, Fechamento);
  barraAtual := barraAtual + 1;

  // 2. F-11: Detecção Fractal Estrita (Janela 5 barras, atraso causal de 2 barras)
  topoFractal := (Maxima[2] > Maxima[3]) e (Maxima[2] > Maxima[4]) e 
                 (Maxima[2] >= Maxima[1]) e (Maxima[2] >= Maxima[0]);
                 
  fundoFractal := (Minima[2] < Minima[3]) e (Minima[2] < Minima[4]) e 
                  (Minima[2] <= Minima[1]) e (Minima[2] <= Minima[0]);

  Se topoFractal Entao
  Inicio
    ultimoTopo := Maxima[2];
    ultimoTopoIdx := CurrentBar - 2;
  Fim;

  Se fundoFractal Entao
  Inicio
    ultimoFundo := Minima[2];
    ultimoFundoIdx := CurrentBar - 2;
  Fim;

  // 3. N-04: Zeragem compulsória day trade B3 (pernas e ordens deixam de ser reenviadas)
  Se (Time >= HorarioZeragem) Entao
  Inicio
    Se HasPosition Entao ClosePosition;
    pernadaAltaAtiva := Falso;
    pernadaBaixaAtiva := Falso;
  Fim;

  // 4. Posição aberta: reenvia stop e alvo A CADA BARRA (N-01) e gerencia trava e saída por MME
  Se HasPosition Entao
  Inicio
    Se IsBought Entao
      precoEntrada := BuyPrice
    Senao Se IsSold Entao
      precoEntrada := SellPrice;

    // Primeira barra com posição: fixa stop, alvo e risco REAL a partir do preço executado
    Se (Not posInicializada) Entao
    Inicio
      posInicializada := Verdadeiro;
      barraEntrada := barraAtual;
      travaAtivada := Falso;
      precoStop := stopPerna;
      precoAlvo := alvoPerna;
      Se IsBought Entao
        riscoInicial := precoEntrada - stopPerna
      Senao
        riscoInicial := stopPerna - precoEntrada;
      pernadaAltaAtiva := Falso;
      pernadaBaixaAtiva := Falso;
    Fim;

    Se UsarTrava2para1 e (barraAtual > barraEntrada) e (Not travaAtivada) e (riscoInicial > 0) Entao
    Inicio
      Se IsBought e ((Maxima - precoEntrada) >= 2.0 * riscoInicial) Entao
      Inicio
        precoStop := precoEntrada + 1.0 * riscoInicial;
        travaAtivada := Verdadeiro;
      Fim
      Senao Se IsSold e ((precoEntrada - Minima) >= 2.0 * riscoInicial) Entao
      Inicio
        precoStop := precoEntrada - 1.0 * riscoInicial;
        travaAtivada := Verdadeiro;
      Fim;
    Fim;

    // L-09: saída por MME 8, só a partir da barra seguinte à entrada e no lucro
    Se (barraAtual > barraEntrada) e IsBought e (Fechamento < mme8) e (Fechamento > precoEntrada) Entao
      ClosePosition
    Senao Se (barraAtual > barraEntrada) e IsSold e (Fechamento > mme8) e (Fechamento < precoEntrada) Entao
      ClosePosition
    Senao Se (Time < HorarioZeragem) Entao
    Inicio
      Se IsBought Entao
      Inicio
        SellToCoverStop(precoStop, precoStop - (OffsetStopTicks * MinPriceIncrement));
        SellToCoverLimit(precoAlvo);
      Fim
      Senao Se IsSold Entao
      Inicio
        BuyToCoverStop(precoStop, precoStop + (OffsetStopTicks * MinPriceIncrement));
        BuyToCoverLimit(precoAlvo);
      Fim;
    Fim;
  Fim
  Senao
  Inicio
    posInicializada := Falso;
    travaAtivada := Falso;

    // 5. BOS (só sem posição, antes do horário limite e com os dois swings já conhecidos)
    Se (Not pernadaAltaAtiva) e (Not pernadaBaixaAtiva) e (Time < HorarioLimiteEntrada)
       e (ultimoTopo > 0) e (ultimoFundo > 0) Entao
    Inicio
      Se (ultimoTopoIdx > ultimoFundoIdx) e (Fechamento > ultimoTopo) e
         ((Maxima - ultimoFundo) > AmplitudeMinimaTicks * MinPriceIncrement) Entao
      Inicio
        pernadaAltaAtiva := Verdadeiro;
        refTopo := Maxima;
        refFundo := ultimoFundo;
        barrasPerna := 0;
        bosBarIdx := barraAtual;
        PaintBar(clAmarelo);
      Fim
      Senao Se (ultimoFundoIdx > ultimoTopoIdx) e (Fechamento < ultimoFundo) e
         ((ultimoTopo - Minima) > AmplitudeMinimaTicks * MinPriceIncrement) Entao
      Inicio
        pernadaBaixaAtiva := Verdadeiro;
        refTopo := ultimoTopo;
        refFundo := Minima;
        barrasPerna := 0;
        bosBarIdx := barraAtual;
        PaintBar(clAmarelo);
      Fim;
    Fim;

    // 6. Perna ativa. F-01: a barra do BOS só arma a ordem; o toque vale da barra seguinte.
    // A ordem limite é reenviada a cada barra enquanto a perna valer (N-02), e a perna só
    // termina por expiração, horário ou toque confirmado. Se a barra tocou o nível e não há
    // posição, a ordem não foi executada: o setup acabou (como o Python, que marca "tocada").
    Se pernadaAltaAtiva ou pernadaBaixaAtiva Entao
    Inicio
      armar := Verdadeiro;

      Se barraAtual > bosBarIdx Entao
      Inicio
        barrasPerna := barrasPerna + 1;
        diffPernada := refTopo - refFundo;

        Se (barrasPerna > MaxBarrasPerna) ou (Time >= HorarioLimiteEntrada) Entao
          armar := Falso
        Senao Se pernadaAltaAtiva Entao
        Inicio
          nivelEntrada := refTopo - (diffPernada * FiboEntrada);
          // F-04: o toque usa o nível calculado até a barra anterior
          Se Minima <= nivelEntrada Entao
            armar := Falso
          Senao Se Maxima > refTopo Entao
            refTopo := Maxima;
        Fim
        Senao
        Inicio
          nivelEntrada := refFundo + (diffPernada * FiboEntrada);
          Se Maxima >= nivelEntrada Entao
            armar := Falso
          Senao Se Minima < refFundo Entao
            refFundo := Minima;
        Fim;
      Fim;

      Se (Not armar) Entao
      Inicio
        pernadaAltaAtiva := Falso;
        pernadaBaixaAtiva := Falso;
      Fim
      Senao
      Inicio
        diffPernada := refTopo - refFundo;

        Se pernadaAltaAtiva Entao
        Inicio
          nivelEntrada := refTopo - (diffPernada * FiboEntrada);
          nivelStop    := refTopo - (diffPernada * FiboStop);
          stopPerna    := nivelStop;
          alvoPerna    := refTopo;
          riscoPerna   := nivelEntrada - nivelStop;
          Se riscoPerna > (RiscoMinimoTicks * MinPriceIncrement) Entao
          Inicio
            BuyLimit(nivelEntrada);
            SellToCoverStop(nivelStop, nivelStop - (OffsetStopTicks * MinPriceIncrement));
            SellToCoverLimit(alvoPerna);
          Fim;
        Fim
        Senao
        Inicio
          nivelEntrada := refFundo + (diffPernada * FiboEntrada);
          nivelStop    := refFundo + (diffPernada * FiboStop);
          stopPerna    := nivelStop;
          alvoPerna    := refFundo;
          riscoPerna   := nivelStop - nivelEntrada;
          Se riscoPerna > (RiscoMinimoTicks * MinPriceIncrement) Entao
          Inicio
            SellShortLimit(nivelEntrada);
            BuyToCoverStop(nivelStop, nivelStop + (OffsetStopTicks * MinPriceIncrement));
            BuyToCoverLimit(alvoPerna);
          Fim;
        Fim;
      Fim;
    Fim;
  Fim;

  // 7. Plot de Níveis
  Se ExibirTopoFundo Entao
  Inicio
    Se refTopo > 0 Entao Plot(refTopo) Senao NoPlot(1);
    Se refFundo > 0 Entao Plot2(refFundo) Senao NoPlot(2);
  Fim;

Fim;
